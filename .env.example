# Hyperswitch sandbox — https://app.hyperswitch.io
# Copy to .env and fill in. Never commit .env.

# Secret API key. Server-side only (api/). Must NEVER carry a VITE_ prefix —
# Vite inlines VITE_* variables into the browser bundle.
JUSPAY_API_TEST_KEY=snd_your_secret_api_key

# Publishable key. Safe for the browser, but deliberately not VITE_-prefixed:
# /api/checkout returns it in its response, so it is never baked into the bundle.
JUSPAY_API_PUBLISHABLE_KEY=pk_snd_your_publishable_key
